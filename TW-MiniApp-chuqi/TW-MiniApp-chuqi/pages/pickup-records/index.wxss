.pickup-records-page {
  min-height: 100vh;
  padding: 110rpx 14rpx 40rpx;
  background: #fff;
  box-sizing: border-box;
}

.pickup-records-topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 8rpx 30rpx;
}

.pickup-records-topbar__back {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pickup-records-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #222;
  border-bottom: 5rpx solid #222;
  transform: rotate(45deg);
}

.pickup-records-topbar__title {
  flex: 1;
  text-align: center;
  padding-right: 52rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
}

.pickup-record-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  background: #fff;
}

.pickup-record-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pickup-record-card__no {
  font-size: 28rpx;
  font-weight: 700;
  color: #1b1b1b;
}

.pickup-record-card__status {
  font-size: 26rpx;
  color: #2f7d32;
}

.pickup-record-card__row {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #555;
}

.pickup-record-card__foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pickup-record-card__time {
  font-size: 24rpx;
  color: #999;
}

.pickup-record-card__amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
}

.pickup-records-empty {
  min-height: calc(100vh - 220rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #9b9b9b;
}
