.home-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 96rpx 24rpx 220rpx;
  background: linear-gradient(180deg, #c8e8a0 0%, #a8d068 55%, #7eb832 100%);
  box-sizing: border-box;
}

.home-stage {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.home-stage__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: scale(1.04);
}

.home-stage__veil {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 18%, rgba(255, 255, 255, 0.2), transparent 30%),
    radial-gradient(circle at 72% 26%, rgba(255, 255, 255, 0.14), transparent 24%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(111, 155, 36, 0.18) 35%, rgba(88, 132, 26, 0.16) 100%);
}

.home-card {
  position: relative;
  z-index: 1;
  margin-top: 500rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.97);
  overflow: hidden;
  box-shadow: 0 22rpx 42rpx rgba(42, 62, 20, 0.1);
}

.home-card__account {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx 22rpx;
  background: linear-gradient(180deg, rgba(210, 239, 194, 0.48), rgba(255, 255, 255, 0.8));
}

.home-card__identity {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.home-card__name-text {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-card__name-text--guest {
  color: #7eb832;
  font-weight: 600;
}

.home-card__phone-text {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-card__stats {
  display: flex;
  align-items: center;
  padding: 20rpx 0 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  margin-top: 8rpx;
}

.home-card__stat {
  flex: 1;
  text-align: center;
}

.home-card__stat-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #2a5018;
}

.home-card__stat-label {
  font-size: 22rpx;
  color: #4a6a2a;
  margin-top: 4rpx;
}

.home-card__stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.08);
}

.home-card__top-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.home-card__feature {
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-right: 1rpx solid rgba(0, 0, 0, 0.08);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.home-card__feature:nth-child(2n) {
  border-right: 0;
}

.home-card__feature-icon-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-card__feature-icon-wrap::after {
  content: '';
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffd228;
}

.home-card__feature-icon-wrap--wallet::after {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.home-card__feature-icon {
  width: 80rpx;
  height: 80rpx;
}

.home-card__feature-copy {
  flex: 1;
  min-width: 0;
}

.home-card__feature-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.home-card__feature-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #7f7f7f;
}

.home-card__bottom-actions {
  display: grid;
  grid-template-columns: 1fr;
}

.home-card__bottom-item {
  min-height: 100rpx;
  padding: 20rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.home-card__bottom-title {
  font-size: 26rpx;
  line-height: 1.35;
  color: #2b2b2b;
  text-align: center;
}

.home-card__badge {
  position: absolute;
  top: 10rpx;
  right: 14rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #ff8745;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}
