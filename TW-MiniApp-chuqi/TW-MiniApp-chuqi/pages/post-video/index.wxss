.video-page {
  min-height: 100vh;
  background: #fff;
  color: #222;
  padding-top: 176rpx;
  padding-bottom: 170rpx;
  box-sizing: border-box;
}

.video-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 12;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 104rpx 28rpx 20rpx;
  background: rgba(255, 255, 255, 0.98);
}

.video-topbar__back {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
}

.video-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #222;
  border-bottom: 5rpx solid #222;
  transform: rotate(45deg);
}

.video-topbar__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
}

.video-editor {
  padding: 8rpx 26rpx 0;
}

.video-media__picker {
  width: 148rpx;
  height: 148rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-media__plus {
  font-size: 54rpx;
  color: #222;
  line-height: 1;
  font-weight: 300;
}

.video-card {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eef0f2;
}

.video-card__cover {
  width: 100%;
  height: 100%;
}

.video-card__duration {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.42);
}

.video-cover-tools {
  margin-top: 20rpx;
}

.video-cover-tools__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f6f4ef;
  font-size: 26rpx;
  color: #6e665a;
}

.video-cover-preview {
  position: relative;
  width: 220rpx;
  height: 124rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #eef0f2;
}

.video-cover-preview__image {
  width: 100%;
  height: 100%;
}

.video-editor__textarea {
  width: 100%;
  min-height: 300rpx;
  margin-top: 24rpx;
  font-size: 34rpx;
  line-height: 1.7;
}

.video-editor__title {
  margin-top: 28rpx;
  font-size: 34rpx;
  color: #222;
}

.media-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background: rgba(0, 0, 0, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.media-remove__line {
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #fff;
}

.video-publishbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #f2eee7;
}

.video-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 2rpx 18rpx;
  border-bottom: 1rpx solid #f2f2f2;
  color: #a0a0a0;
  font-size: 28rpx;
}

.video-location__left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.video-location__icon {
  font-size: 24rpx;
  color: #b1b1b1;
}

.video-location__arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid #d0d0d0;
  border-right: 3rpx solid #d0d0d0;
  transform: rotate(45deg);
}

.video-publishbar__button {
  margin-top: 16rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #f0c27a;
  background: #fff7ea;
  color: #d8a45b;
  font-size: 32rpx;
  font-weight: 700;
}

.video-publishbar__button--active {
  background: linear-gradient(135deg, #f2a43e, #ea7c26);
  border-color: #ea8a2f;
  color: #fffdf9;
}

.editor-sheet__mask {
  position: fixed;
  inset: 0;
  z-index: 39;
  background: rgba(0, 0, 0, 0.24);
}

.editor-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.editor-sheet__title {
  padding: 26rpx 24rpx 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8d8d8d;
}

.editor-sheet__action {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #232323;
  border-top: 1rpx solid #f1f1f1;
}

.editor-sheet__gap {
  height: 14rpx;
  background: #f7f7f7;
}

.editor-sheet__action--cancel {
  font-weight: 500;
}
