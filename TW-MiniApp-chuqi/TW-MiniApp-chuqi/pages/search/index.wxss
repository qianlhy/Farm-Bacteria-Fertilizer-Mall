.search-page {
  min-height: 100vh;
  background: #fff;
  color: #202020;
}

.search-topbar {
  display: flex;
  align-items: center;
  padding: 104rpx 28rpx 18rpx;
}

.search-topbar__close {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.search-topbar__close-line {
  position: absolute;
  left: 20rpx;
  top: 6rpx;
  width: 4rpx;
  height: 32rpx;
  background: #222;
  border-radius: 999rpx;
}

.search-topbar__close-line--a {
  transform: rotate(45deg);
}

.search-topbar__close-line--b {
  transform: rotate(-45deg);
}

.search-input-wrap {
  padding: 0 24rpx;
}

.search-input {
  height: 78rpx;
  border-radius: 16rpx;
  background: #f6f6f6;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
}

.search-input__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #b3b3b3;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-input__icon::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #b3b3b3;
  transform: rotate(45deg);
}

.search-input__field {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
}

.history-block {
  padding: 42rpx 24rpx 0;
}

.history-block__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-block__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #7d7d7d;
}

.history-trash {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.history-trash__lid {
  position: absolute;
  left: 8rpx;
  top: 5rpx;
  width: 20rpx;
  height: 4rpx;
  background: #b0b0b0;
  border-radius: 999rpx;
}

.history-trash__body {
  position: absolute;
  left: 9rpx;
  top: 9rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #b0b0b0;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.history-trash__line {
  position: absolute;
  top: 4rpx;
  width: 3rpx;
  height: 8rpx;
  background: #b0b0b0;
}

.history-trash__line:first-child {
  left: 4rpx;
}

.history-trash__line:last-child {
  right: 4rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.history-tag {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #ececec;
  background: #fff;
  font-size: 28rpx;
  color: #555;
}

.search-results-shell {
  margin-top: 28rpx;
}

.search-tabs {
  white-space: nowrap;
  padding: 0 24rpx 10rpx;
  box-sizing: border-box;
}

.search-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 34rpx;
  padding-bottom: 8rpx;
  font-size: 30rpx;
  color: #9f9f9f;
  font-weight: 600;
}

.search-tab--active {
  color: #1f1f1f;
}

.search-results {
  height: calc(100vh - 258rpx);
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.search-empty {
  padding-top: 120rpx;
  text-align: center;
}

.search-empty__title {
  font-size: 34rpx;
  font-weight: 700;
}

.search-empty__desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #9d9d9d;
}

.search-section {
  margin-bottom: 30rpx;
}

.search-section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.search-section__title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.search-section__arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #8e8e8e;
  border-right: 3rpx solid #8e8e8e;
  transform: rotate(45deg);
}

.user-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.user-row__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 700;
}

.user-row__content {
  flex: 1;
  margin-left: 16rpx;
}

.user-row__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #232323;
}

.user-row__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #989898;
}

.content-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.content-row__thumb {
  width: 132rpx;
  height: 96rpx;
  border-radius: 14rpx;
  flex: 0 0 132rpx;
}

.content-row__content {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.content-row__title {
  font-size: 30rpx;
  line-height: 1.4;
  color: #202020;
  font-weight: 600;
}

.content-row__summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #7f7f7f;
}

.content-row__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a2a2a2;
}

.manual-row {
  padding: 14rpx 0 20rpx;
  border-bottom: 1rpx solid #f3f3f3;
}

.manual-row__title {
  font-size: 34rpx;
  line-height: 1.4;
  color: #202020;
  font-weight: 600;
}

.manual-row__category {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8e8e8e;
}

.manual-row__summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9d9d9d;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx 18rpx;
}

.product-card__cover {
  width: 100%;
  padding-top: 100%;
  border-radius: 4rpx;
}

.product-card__name {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.4;
  color: #1f1f1f;
  font-weight: 600;
}

.product-card__tag {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

.product-card__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9f9f9f;
}

.product-card__price {
  margin-top: 10rpx;
  font-size: 30rpx;
  color: #1f1f1f;
  font-weight: 700;
}
