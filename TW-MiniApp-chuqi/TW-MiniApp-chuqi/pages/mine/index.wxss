.mine-page {
  min-height: 100vh;
  padding: 92rpx 24rpx 220rpx;
  background: linear-gradient(180deg, #c8e8a0 0%, #a8d068 55%, #7eb832 100%);
  box-sizing: border-box;
}

.mine-header {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.mine-header__avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mine-header__login-tip {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.mine-header__nickname {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.mine-header__avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: linear-gradient(145deg, #343434, #101010);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.18);
}

.mine-header__avatar-image {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: #f0f0f0;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.18);
}

.mine-header__slogan {
  margin-top: 10rpx;
  width: 560rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.mine-balance-card {
  margin-top: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  padding: 28rpx 24rpx 26rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.1);
}

.mine-balance-card__identity {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mine-balance-card__phone {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.mine-balance-card__plate {
  font-size: 24rpx;
  color: #666;
}

.mine-balance-card__stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.mine-balance-card__stat {
  text-align: center;
}

.mine-balance-card__value {
  font-size: 56rpx;
  line-height: 1;
  font-weight: 800;
  color: #2a5018;
}

.mine-balance-card__label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #4a6a2a;
}

.mine-banner {
  position: relative;
  margin-top: 20rpx;
  height: 200rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #6aa325, #4e8218);
  display: flex;
  align-items: center;
}

.mine-banner__photo {
  width: 260rpx;
  height: 200rpx;
  flex-shrink: 0;
  opacity: 0.92;
}

.mine-banner__content {
  flex: 1;
  min-width: 0;
  padding: 0 28rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.mine-banner__title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #fff;
}

.mine-banner__subtitle {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #fff;
}

.mine-grid {
  margin-top: 24rpx;
  padding: 28rpx 12rpx 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(26, 60, 16, 0.1);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  row-gap: 32rpx;
}

.mine-grid__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 148rpx;
}

.mine-grid__icon-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #f7faf2;
  box-shadow: inset 0 0 0 1rpx rgba(42, 80, 24, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mine-grid__icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) saturate(100%) invert(24%) sepia(18%) saturate(1200%) hue-rotate(64deg) brightness(95%) contrast(92%);
}

.mine-grid__badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #ff8745;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  z-index: 1;
}

.mine-grid__label {
  margin-top: 12rpx;
  width: 100%;
  padding: 0 4rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #2a5018;
  text-align: center;
  word-break: break-all;
}
