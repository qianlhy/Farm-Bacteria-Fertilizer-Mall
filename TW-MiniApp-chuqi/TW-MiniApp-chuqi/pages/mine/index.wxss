.mine-page {
  min-height: 100vh;
  padding: 92rpx 24rpx 220rpx;
  background: linear-gradient(180deg, #c8e8a0 0%, #a8d068 55%, #7eb832 100%);
  box-sizing: border-box;
}

.mine-header {
  position: relative;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.mine-header__avatar-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mine-header__login-tip {
  position: absolute;
  bottom: -32rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: #fff;
  white-space: nowrap;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.mine-header__user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 8rpx;
}

.mine-header__nickname {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.mine-header__avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: linear-gradient(145deg, #343434, #101010);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.18);
}

.mine-header__avatar-image {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: #f0f0f0;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.18);
}

.mine-header__slogan {
  margin-top: 16rpx;
  width: 520rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #fff;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.mine-balance-card {
  margin-top: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  padding: 28rpx 24rpx 26rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.1);
}

.mine-balance-card__identity {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mine-balance-card__phone {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.mine-balance-card__plate {
  font-size: 24rpx;
  color: #666;
}

.mine-balance-card__stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.mine-balance-card__stat {
  text-align: center;
}

.mine-balance-card__value {
  font-size: 56rpx;
  line-height: 1;
  font-weight: 800;
  color: #2a5018;
}

.mine-balance-card__label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #4a6a2a;
}

.mine-banner {
  position: relative;
  margin-top: 20rpx;
  height: 200rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #6aa325, #4e8218);
}

.mine-banner__photo {
  position: absolute;
  left: 0;
  top: 0;
  width: 260rpx;
  height: 200rpx;
  opacity: 0.92;
}

.mine-banner__tank {
  position: absolute;
  right: -16rpx;
  bottom: -8rpx;
  width: 220rpx;
  height: 200rpx;
  opacity: 0.9;
}

.mine-banner__text {
  position: absolute;
  left: 248rpx;
  top: 50rpx;
  right: 140rpx;
  font-size: 30rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #fff;
}

.mine-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  row-gap: 28rpx;
}

.mine-grid__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.mine-grid__icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine-grid__icon {
  width: 64rpx;
  height: 64rpx;
}

.mine-grid__badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #ff8745;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}

.mine-grid__label {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #1e1e1e;
  text-align: center;
}
