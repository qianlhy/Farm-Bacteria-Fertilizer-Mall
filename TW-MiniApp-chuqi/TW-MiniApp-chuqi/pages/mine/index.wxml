<view class="mine-page">
  <view class="mine-header">
    <view class="mine-header__avatar-wrap" bindtap="handleLoginTap">
      <image
        wx:if="{{loggedIn && avatar}}"
        class="mine-header__avatar-image"
        src="{{avatar}}"
        mode="aspectFill"
      />
      <view wx:else class="mine-header__avatar">{{loggedIn && nickname ? nickname.slice(0, 1) : '农'}}</view>
    </view>
    <view wx:if="{{!loggedIn}}" class="mine-header__login-tip" bindtap="handleLoginTap">点击登录</view>
    <view wx:if="{{loggedIn}}" class="mine-header__nickname">{{nickname || phone}}</view>
    <view class="mine-header__slogan">农家菌肥，服务田间地头</view>
  </view>

  <view class="mine-balance-card">
    <view wx:if="{{loggedIn}}" class="mine-balance-card__phone">{{phone}}</view>
    <view wx:else class="mine-balance-card__guest">登录后查看账户余额</view>

    <view class="mine-balance-card__stats">
      <view class="mine-balance-card__stat">
        <view class="mine-balance-card__value">{{wallet}}</view>
        <view class="mine-balance-card__label">提货余额(Kg)</view>
      </view>
    </view>
  </view>

  <view class="mine-banner" bindtap="openPartner">
    <image class="mine-banner__photo" src="/assets/home/about_useful.jpg" mode="aspectFill" />
    <view class="mine-banner__content">
      <view class="mine-banner__title">加入肽为农家菌肥</view>
      <view class="mine-banner__subtitle">合伙人计划</view>
    </view>
  </view>

  <view class="mine-grid">
    <block wx:for="{{displayTools}}" wx:key="title">
      <view class="mine-grid__item" data-index="{{index}}" bindtap="handleToolTap">
        <view class="mine-grid__icon-wrap">
          <image class="mine-grid__icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="mine-grid__label">{{item.title}}</view>
      </view>
    </block>
  </view>
</view>
