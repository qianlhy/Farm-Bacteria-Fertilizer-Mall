.group-check-page {
  min-height: 100vh;
  padding: 110rpx 18rpx 80rpx;
  background: #fff;
  box-sizing: border-box;
}

.group-check-topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 8rpx 36rpx;
}

.group-check-topbar__back {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.group-check-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #222;
  border-bottom: 5rpx solid #222;
  transform: rotate(45deg);
}

.group-check-topbar__title {
  flex: 1;
  text-align: center;
  padding-right: 52rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
}

.group-check-tabs {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 14rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.group-check-tabs__item {
  flex: 0 0 auto;
  min-width: 120rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #121212;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.group-check-tabs__item--active {
  background: #ffd126;
  font-weight: 700;
}

.group-check-card {
  margin-top: 24rpx;
  padding: 44rpx 28rpx;
  border-radius: 34rpx;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
}

.group-check-card__input {
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #d9d9d9;
  font-size: 30rpx;
}

.group-check-submit {
  margin-top: 28rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #2e2e2e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.group-check-desc {
  margin-top: 34rpx;
  padding: 0 2rpx;
}

.group-check-desc__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
}

.group-check-desc__item {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #111;
}
