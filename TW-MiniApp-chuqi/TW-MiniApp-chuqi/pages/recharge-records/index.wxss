.recharge-records-page {
  min-height: 100vh;
  padding: 110rpx 14rpx 40rpx;
  background: #fff;
  box-sizing: border-box;
}

.recharge-records-topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 8rpx 30rpx;
}

.recharge-records-topbar__back {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recharge-records-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #222;
  border-bottom: 5rpx solid #222;
  transform: rotate(45deg);
}

.recharge-records-topbar__title {
  flex: 1;
  text-align: center;
  padding-right: 52rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
}

.recharge-record-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  background: #fff;
}

.recharge-record-card__left {
  flex: 1;
  min-width: 0;
}

.recharge-record-card__channel {
  font-size: 30rpx;
  font-weight: 700;
  color: #1b1b1b;
}

.recharge-record-card__time {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #333;
}

.recharge-record-card__amount {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #555;
}

.recharge-record-card__gift {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.recharge-record-card__right {
  text-align: right;
}

.recharge-record-card__price {
  font-size: 42rpx;
  font-weight: 800;
  color: #111;
}

.recharge-record-card__points {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.recharge-records-empty {
  min-height: calc(100vh - 220rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #9b9b9b;
}
