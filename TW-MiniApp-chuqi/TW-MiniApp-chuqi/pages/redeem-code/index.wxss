.redeem-page {
  min-height: 100vh;
  padding: 110rpx 24rpx calc(80rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #c8e8a0 0%, #a8d068 55%, #7eb832 100%);
  box-sizing: border-box;
}

.redeem-topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 8rpx 34rpx;
}

.redeem-topbar__back {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.redeem-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #222;
  border-bottom: 5rpx solid #222;
  transform: rotate(45deg);
}

.redeem-topbar__title {
  flex: 1;
  text-align: center;
  padding-right: 52rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
}

.redeem-account {
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #6aa325 0%, #4e8218 100%);
  box-shadow: 0 14rpx 40rpx rgba(42, 62, 20, 0.22);
}

.redeem-account__name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.redeem-account__stats {
  display: flex;
  margin-top: 24rpx;
  gap: 12rpx;
}

.redeem-account__stat {
  flex: 1;
}

.redeem-account__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.redeem-account__value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.redeem-card {
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 36rpx rgba(42, 62, 20, 0.12);
}

.redeem-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d3d1f;
}

.redeem-card__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #66735a;
}

.redeem-card__input {
  margin-top: 28rpx;
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #f5f7f2;
  font-size: 30rpx;
  color: #222;
}

.redeem-card__submit {
  margin-top: 28rpx;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4e8218 0%, #355f10 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.redeem-card__submit--disabled {
  opacity: 0.65;
}

.redeem-result {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
}

.redeem-result__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2d3d1f;
}

.redeem-result__summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4e8218;
  font-weight: 600;
}

.redeem-result__row {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #66735a;
}
