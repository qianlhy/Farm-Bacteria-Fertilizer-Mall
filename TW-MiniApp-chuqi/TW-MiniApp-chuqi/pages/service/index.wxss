.pickup-page {
  min-height: 100vh;
  padding: 100rpx 24rpx 220rpx;
  background: #f3f0e6;
  box-sizing: border-box;
}

.pickup-shell {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pickup-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 4rpx 4rpx;
}

.pickup-header__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #24351d;
}

.pickup-header__right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pickup-header__records {
  font-size: 26rpx;
  color: #2f7d32;
  padding: 6rpx 18rpx;
  border: 1rpx solid #bfe0bf;
  border-radius: 999rpx;
  background: #f2f9f1;
}

.pickup-header__balance {
  font-size: 26rpx;
  color: #5a6b52;
}

.pickup-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(49, 42, 33, 0.05);
}

.pickup-card__label {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #24351d;
}

.pickup-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pickup-chip-row--sub {
  margin-top: 12rpx;
}

.pickup-chip-row--inline {
  margin-top: 12rpx;
}

.pickup-chip {
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f3f0e6;
  color: #4a5544;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pickup-chip--small {
  min-height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.pickup-chip--active {
  background: #2a5018;
  color: #fff;
}

.pickup-quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pickup-quantity-row__meta {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #66735d;
}

.pickup-stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pickup-stepper__btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f3f0e6;
  color: #24351d;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pickup-stepper__input {
  width: 88rpx;
  height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #24351d;
}

.pickup-address-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0ece2;
}

.pickup-address-block__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pickup-address-block__hint {
  font-size: 24rpx;
  color: #8a8175;
}

.pickup-address-block__pick {
  font-size: 26rpx;
  color: #2a5018;
  font-weight: 600;
}

.pickup-field {
  margin-bottom: 16rpx;
}

.pickup-field__label {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #8a8175;
}

.pickup-field__input {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f8f6f0;
  font-size: 28rpx;
  color: #24351d;
}

.pickup-address-actions {
  margin-top: 8rpx;
}

.pickup-address-actions__btn {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #eef5e8;
  color: #2a5018;
  font-size: 24rpx;
}

.pickup-pay-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0ece2;
  font-size: 26rpx;
  color: #4a5544;
}

.pickup-pay-line--muted {
  color: #8a9384;
  font-size: 24rpx;
}

.pickup-summary-line__strong {
  color: #2a5018;
  font-size: 30rpx;
  font-weight: 600;
}

.pickup-pay-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa291;
  line-height: 1.5;
}

.pickup-pay-line:last-of-type {
  border-bottom: none;
}

.pickup-pay-line__note {
  float: right;
  color: #8a9384;
  font-size: 24rpx;
}

.pickup-summary-line {
  margin-top: 16rpx;
  padding: 16rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #24351d;
}

.pickup-summary-line__toggle {
  color: #2a5018;
  font-size: 24rpx;
}

.pickup-detail {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e8e2d6;
}

.pickup-detail__row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #66735d;
}

.pickup-tip {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.pickup-tip--warn {
  background: #fff7e8;
  color: #a66d1d;
}

.pickup-tip--error {
  background: #fbefec;
  color: #c46f5c;
}

.pickup-submit {
  margin-top: 8rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #2a5018;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pickup-submit--disabled {
  opacity: 0.45;
}

.address-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}

.address-panel {
  width: 100%;
  max-height: 70vh;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.address-panel__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #24351d;
}

.address-panel__list {
  max-height: 48vh;
  margin-top: 20rpx;
}

.address-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0ece2;
}

.address-item__main {
  flex: 1;
  min-width: 0;
}

.address-item__label {
  font-size: 28rpx;
  font-weight: 600;
  color: #24351d;
}

.address-item__address {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #66735d;
}

.address-item__phone {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8175;
}

.address-item__delete {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #c46f5c;
}

.address-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a8175;
}

.address-panel__close {
  margin-top: 20rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #f3f0e6;
  color: #24351d;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
