.pickup-page {
  position: relative;
  min-height: 100vh;
  padding: 88rpx 24rpx 220rpx;
  background: linear-gradient(180deg, #d6eebe 0%, #f3f0e6 28%, #f5f2ea 100%);
  box-sizing: border-box;
  overflow: hidden;
}

.pickup-stage {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.pickup-stage__glow {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(10rpx);
  opacity: 0.75;
}

.pickup-stage__glow--left {
  left: -120rpx;
  top: 150rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 255, 255, 0.44);
}

.pickup-stage__glow--right {
  right: -110rpx;
  top: 40rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(123, 196, 72, 0.24);
}

.pickup-shell {
  position: relative;
  z-index: 1;
}

.pickup-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(241, 249, 231, 0.96));
  box-shadow: 0 24rpx 48rpx rgba(71, 103, 34, 0.12);
}

.pickup-hero__copy {
  flex: 1;
  min-width: 0;
}

.pickup-hero__eyebrow {
  font-size: 22rpx;
  letter-spacing: 5rpx;
  color: #7aa64a;
}

.pickup-hero__title {
  margin-top: 16rpx;
  font-size: 46rpx;
  line-height: 1.28;
  font-weight: 700;
  color: #24351d;
}

.pickup-hero__desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #66735d;
}

.pickup-hero__icon {
  width: 126rpx;
  height: 126rpx;
  flex: 0 0 126rpx;
}

.pickup-balance-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1d6e38, #2ea854 62%, #3fbe66 100%);
  box-shadow: 0 20rpx 40rpx rgba(39, 124, 60, 0.18);
}

.pickup-balance-card__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.pickup-balance-card__stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.pickup-balance-card__stat {
  min-height: 124rpx;
  padding: 20rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  box-sizing: border-box;
}

.pickup-balance-card__label {
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.8);
}

.pickup-balance-card__value {
  margin-top: 12rpx;
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #fff;
  word-break: break-all;
}

.pickup-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.pickup-card--summary {
  background: linear-gradient(135deg, rgba(255, 251, 239, 0.98), rgba(255, 247, 216, 0.98));
}

.pickup-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b3423;
}

.pickup-card__subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7a7b69;
}

.pickup-package {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(73, 106, 32, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: #fffcf6;
  box-sizing: border-box;
}

.pickup-package--active {
  border-color: #64aa32;
  background: linear-gradient(135deg, #f7fff0, #f3fbe6);
  box-shadow: 0 16rpx 34rpx rgba(102, 168, 54, 0.12);
}

.pickup-package__main {
  flex: 1;
  min-width: 0;
}

.pickup-package__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.pickup-package__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #24311d;
}

.pickup-package__badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(103, 165, 51, 0.12);
  font-size: 20rpx;
  color: #4d7c2b;
  white-space: nowrap;
}

.pickup-package__detail {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5c6256;
}

.pickup-package__price {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8e7a4e;
}

.pickup-package__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  background: rgba(103, 165, 51, 0.22);
  flex: 0 0 18rpx;
}

.pickup-package--active .pickup-package__dot {
  background: #64aa32;
  box-shadow: 0 0 0 10rpx rgba(100, 170, 50, 0.14);
}

.pickup-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.pickup-chip-row--compact {
  margin-top: 18rpx;
}

.pickup-chip {
  min-width: 168rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #60584d;
  background: #f4efe4;
  box-sizing: border-box;
}

.pickup-chip--active {
  background: #243521;
  color: #fff;
  box-shadow: 0 14rpx 28rpx rgba(36, 53, 33, 0.14);
}

.pickup-method-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.pickup-method {
  min-height: 176rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fffcf6;
  border: 2rpx solid rgba(73, 106, 32, 0.08);
  box-sizing: border-box;
}

.pickup-method--active {
  border-color: #64aa32;
  background: linear-gradient(135deg, #f8fff3, #f2f9e6);
}

.pickup-method__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #24311d;
}

.pickup-method__desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #67705f;
}

.pickup-inline-tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #6d7565;
}

.pickup-inline-tip--emphasis {
  color: #7f6a41;
}

.pickup-address {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f8f6ef;
}

.pickup-address__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2b3423;
}

.pickup-address__field {
  margin-top: 16rpx;
  min-height: 96rpx;
  padding: 0 22rpx 0 18rpx;
  border-radius: 24rpx;
  border: 4rpx solid #f06d3c;
  background: #fffdf9;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.pickup-address__icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f06d3c;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  flex: 0 0 40rpx;
}

.pickup-address__input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #283021;
}

.pickup-address__hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7d7b70;
}

.pickup-alert {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.pickup-alert--warn {
  background: #fff6db;
  color: #9a6900;
}

.pickup-alert--error {
  background: #fff0ef;
  color: #b1433a;
}

.pickup-quantity {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.pickup-quantity__meta {
  flex: 1;
  min-width: 0;
}

.pickup-quantity__summary {
  font-size: 30rpx;
  font-weight: 700;
  color: #23311c;
}

.pickup-stepper {
  width: 292rpx;
  height: 94rpx;
  border-radius: 26rpx;
  background: #f3f4f1;
  display: flex;
  align-items: center;
  overflow: hidden;
  flex-shrink: 0;
}

.pickup-stepper__btn {
  width: 82rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #24311d;
}

.pickup-stepper__input {
  flex: 1;
  height: 100%;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #24311d;
  border-left: 1rpx solid rgba(36, 49, 29, 0.08);
  border-right: 1rpx solid rgba(36, 49, 29, 0.08);
}

.pickup-breakdown {
  margin-top: 20rpx;
}

.pickup-breakdown__row,
.pickup-summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
  color: #374131;
}

.pickup-breakdown__row + .pickup-breakdown__row,
.pickup-summary__row + .pickup-summary__row {
  border-top: 1rpx solid rgba(45, 61, 31, 0.07);
}

.pickup-pay-block {
  margin-top: 22rpx;
}

.pickup-pay-block__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.pickup-pay-block__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2b3423;
}

.pickup-pay-block__amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #b66d1f;
}

.pickup-pay-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.pickup-pay-grid--triple {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.pickup-pay-option {
  min-height: 136rpx;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: #fbf8f0;
  border: 2rpx solid rgba(86, 86, 72, 0.08);
  box-sizing: border-box;
}

.pickup-pay-option--active {
  background: linear-gradient(135deg, #fff7e7, #fff1c7);
  border-color: #e3b545;
  box-shadow: 0 16rpx 32rpx rgba(220, 174, 62, 0.12);
}

.pickup-pay-option__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2f3327;
}

.pickup-pay-option__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #7b756a;
}

.pickup-summary {
  margin-top: 16rpx;
}

.pickup-submit {
  margin-top: 24rpx;
  height: 108rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #263a22, #183018);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 20rpx 34rpx rgba(30, 52, 26, 0.18);
}

.pickup-submit--disabled {
  background: linear-gradient(135deg, #c8cfc4, #b9c2b5);
  color: rgba(255, 255, 255, 0.95);
  box-shadow: none;
}
