<view class="pickup-page">
  <view class="pickup-shell">
    <view class="pickup-header">
      <view class="pickup-header__title">提货</view>
      <view class="pickup-header__balance">余额 {{pickupBalanceText}} Kg</view>
    </view>

    <view class="pickup-card">
      <view class="pickup-card__label">包装物</view>
      <view class="pickup-chip-row">
        <block wx:for="{{packagingOptions}}" wx:key="key">
          <view
            class="pickup-chip {{selectedPackagingKey === item.key ? 'pickup-chip--active' : ''}}"
            data-key="{{item.key}}"
            bindtap="selectPackaging"
          >{{item.title}}</view>
        </block>
      </view>
      <view wx:if="{{selectedPackaging}}" class="pickup-chip-row pickup-chip-row--sub">
        <block wx:for="{{selectedPackaging.conditions}}" wx:key="key">
          <view
            class="pickup-chip pickup-chip--small {{selectedConditionKey === item.key ? 'pickup-chip--active' : ''}}"
            data-key="{{item.key}}"
            bindtap="selectCondition"
          >{{item.label}}</view>
        </block>
      </view>
    </view>

    <view class="pickup-card">
      <view class="pickup-card__label">数量</view>
      <view class="pickup-quantity-row">
        <view class="pickup-stepper">
          <view class="pickup-stepper__btn" bindtap="decreaseQuantity">-</view>
          <input class="pickup-stepper__input" type="number" value="{{quantityText}}" bindinput="onQuantityInput" bindblur="onQuantityBlur" />
          <view class="pickup-stepper__btn" bindtap="increaseQuantity">+</view>
        </view>
        <view class="pickup-quantity-row__meta">{{quantitySummaryText}}</view>
      </view>
    </view>

    <view class="pickup-card">
      <view class="pickup-card__label">配送</view>
      <view class="pickup-chip-row">
        <block wx:for="{{deliveryOptions}}" wx:key="key">
          <view
            class="pickup-chip {{deliveryMethod === item.key ? 'pickup-chip--active' : ''}}"
            data-key="{{item.key}}"
            bindtap="selectDeliveryMethod"
          >{{item.title}}</view>
        </block>
      </view>

      <view wx:if="{{needsCountyScope}}" class="pickup-address-block">
        <view class="pickup-address-block__toolbar">
          <view class="pickup-address-block__hint">县城范围内配送，起送 1 吨</view>
          <view class="pickup-address-block__pick" bindtap="openAddressBook">地址簿</view>
        </view>

        <view class="pickup-field">
          <view class="pickup-field__label">卸货地址</view>
          <input class="pickup-field__input" placeholder="选填或手动输入" value="{{deliveryAddress}}" bindinput="onDeliveryAddressInput" />
        </view>
        <view class="pickup-field">
          <view class="pickup-field__label">收货人</view>
          <input class="pickup-field__input" placeholder="选填" value="{{receiverName}}" bindinput="onReceiverNameInput" />
        </view>
        <view class="pickup-field">
          <view class="pickup-field__label">联系电话</view>
          <input class="pickup-field__input" type="number" maxlength="11" placeholder="选填" value="{{receiverPhone}}" bindinput="onReceiverPhoneInput" />
        </view>

        <view class="pickup-address-actions">
          <view class="pickup-address-actions__btn" bindtap="saveCurrentAddress">保存到地址簿</view>
        </view>
      </view>

      <view wx:if="{{deliveryWarning}}" class="pickup-tip pickup-tip--warn">{{deliveryWarning}}</view>
    </view>

    <view class="pickup-card">
      <view class="pickup-card__label">支付</view>
      <view wx:if="{{packagingPayAvailable}}" class="pickup-pay-line">
        <text>包装费 ￥{{packagingFeeText}}</text>
        <view class="pickup-chip-row pickup-chip-row--inline">
          <block wx:for="{{packagingPayOptions}}" wx:key="key">
            <view
              class="pickup-chip pickup-chip--small {{packagingPayMethod === item.key ? 'pickup-chip--active' : ''}}"
              data-key="{{item.key}}"
              bindtap="selectPackagingPayMethod"
            >{{item.title}}</view>
          </block>
        </view>
      </view>
      <view wx:if="{{freightAvailable}}" class="pickup-pay-line">
        <text>配送费 ￥{{deliveryFeeText}}</text>
        <view class="pickup-chip-row pickup-chip-row--inline">
          <block wx:for="{{freightPayOptions}}" wx:key="key">
            <view
              class="pickup-chip pickup-chip--small {{freightPayMethod === item.key ? 'pickup-chip--active' : ''}}"
              data-key="{{item.key}}"
              bindtap="selectFreightPayMethod"
            >{{item.title}}</view>
          </block>
        </view>
      </view>
      <view class="pickup-summary-line" bindtap="toggleDetail">
        <text>本次扣减 {{deductKgLabel}} · 现金 {{totalCashLabel}}</text>
        <text class="pickup-summary-line__toggle">{{showDetail ? '收起' : '明细'}}</text>
      </view>
      <view wx:if="{{showDetail}}" class="pickup-detail">
        <view class="pickup-detail__row"><text>积分</text><text>{{totalPointsLabel}}</text></view>
        <view class="pickup-detail__row"><text>运补抵扣</text><text>{{subsidyLabel}}</text></view>
        <view class="pickup-detail__row"><text>包装抵扣</text><text>{{packagingCreditLabel}}</text></view>
        <view class="pickup-detail__row"><text>提货后余额</text><text>{{balanceAfterText}} Kg</text></view>
      </view>
    </view>

    <view wx:if="{{primaryError}}" class="pickup-tip pickup-tip--error">{{primaryError}}</view>

    <view class="pickup-submit {{canSubmit && !submitting ? '' : 'pickup-submit--disabled'}}" bindtap="submitPickup">
      <text wx:if="{{submitting}}">提交中...</text>
      <text wx:else>确认提货</text>
    </view>
  </view>

  <view wx:if="{{addressBookVisible}}" class="address-mask" bindtap="closeAddressBook">
    <view class="address-panel" catchtap="noop">
      <view class="address-panel__title">地址簿</view>
      <scroll-view scroll-y class="address-panel__list">
        <block wx:for="{{addressList}}" wx:key="id">
          <view class="address-item">
            <view class="address-item__main" data-id="{{item.id}}" bindtap="applyAddress">
              <view class="address-item__label">{{item.label || item.contactName || '未命名地址'}}</view>
              <view class="address-item__address">{{item.address}}</view>
              <view wx:if="{{item.contactPhone}}" class="address-item__phone">{{item.contactName}} {{item.contactPhone}}</view>
            </view>
            <view class="address-item__delete" data-id="{{item.id}}" catchtap="removeAddressItem">删除</view>
          </view>
        </block>
        <view wx:if="{{!addressList.length}}" class="address-empty">暂无保存地址，填写后可保存</view>
      </scroll-view>
      <view class="address-panel__close" bindtap="closeAddressBook">关闭</view>
    </view>
  </view>
</view>
