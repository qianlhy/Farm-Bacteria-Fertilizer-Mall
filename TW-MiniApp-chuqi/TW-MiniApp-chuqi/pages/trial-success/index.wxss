.trial-success-page {
  min-height: 100vh;
  background: #fff6ea;
  color: #222;
  padding: 0 24rpx 160rpx;
  box-sizing: border-box;
}

.trial-success-topbar {
  padding: 104rpx 0 28rpx;
}

.trial-success-topbar__back {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trial-success-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #222;
  border-bottom: 5rpx solid #222;
  transform: rotate(45deg);
}

.trial-success-card {
  position: relative;
  height: 1250rpx;
  overflow: hidden;
}

.trial-success-card__art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.trial-success-card__content {
  position: absolute;
  top: 178rpx;
  left: 102rpx;
  width: 400rpx;
  z-index: 2;
}

.trial-success-card__title {
  font-size: 54rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #ef5b2d;
}

.trial-success-card__desc {
  margin-top: 20rpx;
  width: 404rpx;
  font-size: 25rpx;
  line-height: 1.9;
  color: #4f473e;
}

.trial-success-card__meta-panel {
  width: 346rpx;
  margin-top: 122rpx;
}

.trial-success-card__meta-group {
  margin-top: 38rpx;
}

.trial-success-card__meta-group:first-child {
  margin-top: 0;
}

.trial-success-card__meta-value {
  font-size: 30rpx;
  line-height: 1.5;
  color: #242424;
  font-weight: 600;
}

.trial-success-card__meta-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9a9186;
}

.trial-success-card__tank {
  position: absolute;
  right: 96rpx;
  top: 508rpx;
  width: 220rpx;
  height: 220rpx;
  z-index: 2;
}

.trial-success-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
}

.trial-success-actions__button {
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #10152a;
  color: #fffef8;
  font-size: 32rpx;
  font-weight: 700;
}

.trial-state {
  padding: 120rpx 32rpx 0;
  text-align: center;
}

.trial-state__title {
  color: #222;
  font-size: 34rpx;
  font-weight: 700;
}

.trial-state__desc {
  margin-top: 16rpx;
  color: #8a8175;
  font-size: 26rpx;
  line-height: 1.7;
}

.trial-state__button {
  margin: 40rpx auto 0;
  width: 320rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #10152a;
  color: #fffef8;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
