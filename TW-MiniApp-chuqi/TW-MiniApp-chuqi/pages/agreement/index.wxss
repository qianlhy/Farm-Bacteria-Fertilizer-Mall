.agreement-page {
  min-height: 100vh;
  padding: 110rpx 30rpx 60rpx;
  background: #fff;
  box-sizing: border-box;
}

.agreement-topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 0 20rpx;
}

.agreement-topbar__back {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agreement-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #222;
  border-bottom: 5rpx solid #222;
  transform: rotate(45deg);
}

.agreement-topbar__title {
  flex: 1;
  text-align: center;
  padding-right: 52rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
}

.agreement-head {
  padding: 10rpx 0 24rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 24rpx;
}

.agreement-head__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b1b1b;
}

.agreement-head__date {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa291;
}

.agreement-section {
  margin-bottom: 30rpx;
}

.agreement-section__heading {
  font-size: 30rpx;
  font-weight: 600;
  color: #2a5018;
  margin-bottom: 12rpx;
}

.agreement-section__para {
  font-size: 27rpx;
  line-height: 1.8;
  color: #4a5544;
  margin-bottom: 8rpx;
  text-align: justify;
}
