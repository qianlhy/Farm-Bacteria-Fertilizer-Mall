.agri-page {
  min-height: 100vh;
  padding: 40rpx 32rpx 160rpx;
  box-sizing: border-box;
  background: #f0ece2;
}

.agri-hero {
  padding: 24rpx 8rpx 32rpx;
}

.agri-hero__eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #b0a890;
}

.agri-hero__title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #4a3f2a;
}

.agri-hero__subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8a8067;
}

.agri-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.agri-card {
  background: #fffdf8;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(125, 92, 41, 0.08);
}

.agri-card__cover {
  width: 100%;
  height: 220rpx;
  display: block;
}

.agri-card__body {
  padding: 20rpx;
}

.agri-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #4a3f2a;
}

.agri-card__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8067;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.agri-empty {
  margin-top: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #b0a890;
}
