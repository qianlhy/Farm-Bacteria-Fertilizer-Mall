.benefit-page {
  min-height: 100vh;
  padding: 110rpx 24rpx 220rpx;
  background: linear-gradient(180deg, #c8e8a0 0%, #a8d068 55%, #7eb832 100%);
  box-sizing: border-box;
}

.benefit-hero {
  padding: 36rpx 12rpx 32rpx;
}

.benefit-hero__eyebrow {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.75);
}

.benefit-hero__title {
  margin-top: 12rpx;
  font-size: 68rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.benefit-card {
  margin-bottom: 20rpx;
  padding: 32rpx 30rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 36rpx rgba(74, 130, 24, 0.12);
}

.benefit-card__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.benefit-card__desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #666;
}

.benefit-card__button {
  margin-top: 28rpx;
  width: 200rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #6aa325, #4e8218);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(74, 130, 24, 0.28);
}
