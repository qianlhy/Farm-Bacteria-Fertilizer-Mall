<view class="agri-page">
  <view class="agri-hero">
    <view class="agri-hero__eyebrow">AGRICULTURE</view>
    <view class="agri-hero__title">农业作物</view>
    <view class="agri-hero__subtitle">点击作物查看试验报告</view>
  </view>

  <view class="agri-grid">
    <block wx:for="{{crops}}" wx:key="id">
      <view class="agri-card" data-id="{{item.id}}" bindtap="openCrop">
        <image class="agri-card__cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="agri-card__body">
          <view class="agri-card__name">{{item.name}}</view>
          <view class="agri-card__desc">{{item.summary}}</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{loaded && !crops.length}}" class="agri-empty">作物内容整理中，敬请期待</view>
</view>
