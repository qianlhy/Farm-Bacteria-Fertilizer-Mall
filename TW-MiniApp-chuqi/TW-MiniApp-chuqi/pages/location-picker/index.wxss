.location-page {
  min-height: 100vh;
  background: #efefef;
  padding-top: calc(164rpx + env(safe-area-inset-top));
  box-sizing: border-box;
}

.location-sheet {
  min-height: calc(100vh - 164rpx - env(safe-area-inset-top));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.04);
}

.location-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 18rpx;
}

.location-sheet__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #222;
}

.location-sheet__close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: #222;
  line-height: 1;
}

.location-search {
  padding: 0 24rpx 14rpx;
}

.location-search__bar {
  height: 76rpx;
  border-radius: 16rpx;
  background: #f6f6f6;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
}

.location-search__icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #b1b1b1;
}

.location-search__input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
}

.location-option {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 20rpx 24rpx;
}

.location-option__icon {
  width: 34rpx;
  flex: 0 0 34rpx;
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #626262;
  text-align: center;
}

.location-option__content {
  flex: 1;
}

.location-option__name {
  font-size: 34rpx;
  line-height: 1.45;
  color: #202020;
}

.location-option__detail {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9d9d9d;
}
