.action-page {
  padding: 110rpx 24rpx 80rpx;
}

.action-topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-topbar__back {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #4a4338;
  border-bottom: 5rpx solid #4a4338;
  transform: rotate(45deg);
}

.action-topbar__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a4338;
}

.action-card {
  padding: 30rpx;
}

.action-card__title {
  font-size: 38rpx;
  font-weight: 700;
}

.action-card__desc {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #726654;
}

.lottery-stats {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.lottery-stats__item {
  flex: 1;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f7f3ea;
  text-align: center;
}

.lottery-stats__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #7d5c29;
}

.lottery-stats__label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8175;
}

.lottery-actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lottery-actions__button {
  height: 88rpx;
  border-radius: 44rpx;
  background: #f0ece2;
  color: #4a4338;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lottery-actions__button--primary {
  background: #10152a;
  color: #fffef8;
}
