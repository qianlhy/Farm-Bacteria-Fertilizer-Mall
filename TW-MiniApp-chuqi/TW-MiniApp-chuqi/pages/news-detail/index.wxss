.detail-page {
  min-height: 100vh;
  background: #fbfaf7;
  color: #222;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.detail-hero {
  position: relative;
  background: #2c2923;
}

.detail-hero__swiper,
.detail-hero__video {
  width: 100%;
  height: 450rpx;
}

.detail-hero__image {
  width: 100%;
  height: 100%;
  display: block;
}

.detail-hero__image--contain {
  background: #1d1b18;
}

.detail-hero--video {
  overflow: hidden;
}

.article-hero__slide {
  width: 100%;
  height: 100%;
}

.article-hero__slide--field-a {
  background:
    linear-gradient(180deg, rgba(19, 23, 15, 0.12), rgba(19, 23, 15, 0.55)),
    linear-gradient(135deg, #5c7d44 0%, #86ad5d 24%, #cf985c 72%, #f0d28b 100%);
}

.article-hero__slide--field-b {
  background:
    linear-gradient(180deg, rgba(19, 23, 15, 0.1), rgba(19, 23, 15, 0.48)),
    linear-gradient(135deg, #7b9d50 0%, #caa55a 52%, #63492d 100%);
}

.article-hero__slide--soil-a {
  background:
    linear-gradient(180deg, rgba(17, 21, 18, 0.12), rgba(17, 21, 18, 0.5)),
    linear-gradient(135deg, #5e8579 0%, #a6c3ad 30%, #ceb384 100%);
}

.article-hero__slide--coupon-a {
  background:
    linear-gradient(180deg, rgba(25, 18, 14, 0.12), rgba(25, 18, 14, 0.55)),
    linear-gradient(135deg, #8a5c47 0%, #c17647 46%, #f0c870 100%);
}

.article-hero__slide--harvest-a {
  background:
    linear-gradient(180deg, rgba(20, 21, 15, 0.12), rgba(20, 21, 15, 0.52)),
    linear-gradient(135deg, #6e8447 0%, #a48a52 55%, #f0d28e 100%);
}

.detail-topbar {
  position: fixed;
  top: 104rpx;
  left: 24rpx;
  z-index: 12;
  display: flex;
  align-items: center;
}

.detail-topbar__back,
.detail-topbar__share {
  width: 54rpx;
  height: 54rpx;
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #fff;
  border-bottom: 5rpx solid #fff;
  transform: rotate(45deg);
}


.detail-hero__segments {
  margin-top: 18rpx;
  margin-bottom: 8rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.detail-hero__segment {
  width: 22rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #d0cbc4;
}

.detail-hero__segment--active {
  background: #f06b45;
}

.detail-content {
  position: relative;
  z-index: 2;
  margin-top: 0;
  padding: 0 24rpx;
  background: #fbfaf7;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.detail-heading {
  padding: 34rpx 28rpx 10rpx;
}

.detail-heading__title {
  font-size: 46rpx;
  line-height: 1.32;
  font-weight: 700;
  color: #1f1f1f;
}

.detail-heading__subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8b816f;
}

.detail-admin-actions {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.detail-admin-actions__button {
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f4f1ea;
  color: #776d5d;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-admin-actions__button--danger {
  background: #fbefec;
  color: #c46f5c;
}

.detail-body {
  padding: 8rpx 28rpx 0;
}

.detail-body__paragraph {
  margin-top: 22rpx;
  font-size: 30rpx;
  line-height: 1.9;
  color: #443b31;
}

.detail-gallery__image {
  width: 100%;
  margin-top: 22rpx;
  border-radius: 24rpx;
  background: #f2f0ec;
}

.detail-video-card {
  position: relative;
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #111;
}

.detail-video-card__player {
  width: 100%;
  height: 420rpx;
  display: block;
}

.detail-video-card__duration {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.36);
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
}

.detail-location {
  margin: 28rpx 28rpx 40rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eee7db;
  font-size: 24rpx;
  color: #958978;
}
