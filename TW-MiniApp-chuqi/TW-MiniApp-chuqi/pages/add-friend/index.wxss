.add-friend-page {
  min-height: 100vh;
  background: #fff;
  color: #222;
  padding-top: 166rpx;
  box-sizing: border-box;
}

.add-friend-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 12;
  display: flex;
  align-items: center;
  padding: 104rpx 28rpx 18rpx;
  background: rgba(255, 255, 255, 0.98);
}

.add-friend-topbar__back {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-friend-topbar__back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #222;
  border-bottom: 5rpx solid #222;
  transform: rotate(45deg);
}

.add-friend-search {
  padding: 0 24rpx;
}

.add-friend-search__bar {
  height: 78rpx;
  border-radius: 16rpx;
  background: #f6f6f6;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
}

.add-friend-search__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #b3b3b3;
  border-radius: 50%;
  box-sizing: border-box;
}

.add-friend-search__icon::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #b3b3b3;
  transform: rotate(45deg);
}

.add-friend-search__input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
}

.add-friend-search__clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #bcbcbc;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.add-friend-empty {
  padding: 80rpx 36rpx 0;
  text-align: center;
}

.add-friend-empty__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #323232;
}

.add-friend-empty__desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #969696;
}

.add-friend-results {
  padding: 24rpx;
}

.friend-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}

.friend-row__avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 41rpx;
  background: linear-gradient(135deg, #8bb565, #d48a48);
  color: #fffdf8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.friend-row__content {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.friend-row__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.friend-row__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7f7f7f;
}

.friend-row__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a0a0a0;
}

.friend-row__action {
  min-width: 108rpx;
  height: 60rpx;
  padding: 0 18rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5a645;
  color: #fffdf8;
  font-size: 26rpx;
  font-weight: 700;
}

.friend-row__action--added {
  background: #f2f2f2;
  color: #a1a1a1;
}
