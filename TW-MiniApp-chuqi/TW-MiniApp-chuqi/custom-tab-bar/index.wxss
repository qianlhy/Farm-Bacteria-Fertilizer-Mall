.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.tabbar {
  display: flex;
  align-items: flex-end;
  padding: 10rpx 10rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 252, 245, 0.98);
  border-top: 1rpx solid rgba(82, 94, 86, 0.1);
  box-shadow: 0 -8rpx 20rpx rgba(86, 61, 28, 0.06);
}

.tabbar__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-top: 8rpx;
}

.tabbar__item--raised {
  margin-top: -46rpx;
}

.tabbar__icon-shell {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tabbar__login-dot {
  position: absolute;
  top: 4rpx;
  right: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff3b30;
  border: 2rpx solid #fff;
}

.tabbar__icon-image {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.85;
}

.tabbar__icon-image--active {
  opacity: 1;
  transform: scale(1.04);
}

.tabbar__raised-wrap {
  width: 110rpx;
  display: flex;
  justify-content: center;
}

.tabbar__raised-circle {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  border: 10rpx solid rgba(255, 252, 245, 0.98);
  box-sizing: border-box;
  background: linear-gradient(145deg, #6aa325, #4e8218);
  box-shadow: 0 16rpx 34rpx rgba(74, 130, 24, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar__raised-icon {
  width: 66rpx;
  height: 66rpx;
  opacity: 0.92;
}

.tabbar__raised-icon--active {
  opacity: 1;
  transform: scale(1.04);
}

.tabbar__raised-circle--active {
  background: linear-gradient(145deg, #4e8218, #3a6212);
  box-shadow: 0 18rpx 38rpx rgba(58, 98, 18, 0.36);
}

.tabbar__label {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: #8a8070;
}

.tabbar__label--active {
  color: #4a7c18;
  font-weight: 700;
}

.tabbar__label--raised {
  margin-top: 6rpx;
}
